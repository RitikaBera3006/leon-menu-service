# Application
APP_NAME=Leon Menu Service
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development
SENTRY_DSN=

# API
API_V1_PREFIX=/api/v1

# Database — this service owns its own Postgres schema, separate from
# leon-api's database. Run `alembic upgrade head` against it before first use.
DATABASE_URL=postgresql+asyncpg://username:password@your-server/leon_menu_db
# Seconds a request waits for a free pooled connection before failing fast.
DB_POOL_TIMEOUT_SECONDS=10

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# Docs Basic auth (Scalar /openapi.json and /docs when ENVIRONMENT is local or development)
# Staging/production do not mount docs. Leave empty to return 503 on docs in local/development.
DOCS_BASIC_AUTH_USERNAME=
DOCS_BASIC_AUTH_PASSWORD=
